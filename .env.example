# Configurações opcionais para envio real de códigos de 6 dígitos
# Se não preenchido, o sistema funciona em modo de teste local

# E-mail (SMTP - ex: Gmail com Senha de App)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
